Algoritmo sin_titulo
	Escribir "Dame numero 1"
	Leer numero1
	Escribir "Dame numero 2"
	Leer numero2
	Si numero1 > numero2 Entonces
		Escribir "numero1 mayor ", numero1, " > ", numero2
	SiNo
		Si numero1 = numero2 Entonces
			Escribir "numero1 igual ", numero1, " = ", numero2
		SiNo
			Escribir "numero1 menor ", numero1, " < ", numero2
		Fin Si
	Fin Si
FinAlgoritmo
