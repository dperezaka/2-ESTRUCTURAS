Proceso sin_titulo
	Escribir "Dame una nota de 1 a 100"
	Leer nota
	Si nota > 90 Entonces
		Escribir "Nota A"
	Fin Si
	Si nota <= 89 Y nota > 80 Entonces
		Escribir "Nota B"
	Fin Si
	Si nota <= 79 Y nota > 70 Entonces
		Escribir "Nota C"
	Fin Si
	Si nota <= 69 Y nota > 60 Entonces
		Escribir "Nota D"
	Fin Si
	Si nota <= 59 Y nota > 50 Entonces
		Escribir "Nota E"
	Fin Si
	Si nota < 50 Entonces
		Escribir "Nota F"
	Fin Si
FinProceso